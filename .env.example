# ---------- core ----------
ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me
PUBLIC_BASE_URL=http://localhost:8000

# ---------- database ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=support
# Application engine (SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
# LangGraph checkpointer needs psycopg 3, not asyncpg. Same database, separate pool.
CHECKPOINT_DATABASE_URL=postgresql://support:support@localhost:5432/support
LANGGRAPH_STRICT_MSGPACK=true
DB_POOL_SIZE=5
CHECKPOINT_POOL_SIZE=5

# ---------- llm ----------
# Model ids verified 2026-09-08. They live here and nowhere else in the codebase.
# provider: gemini | groq | stub   (stub = deterministic offline fake, no key needed)
LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=

MODEL_CLASSIFY=gemini-3.5-flash-lite
MODEL_REASON=gemini-3.8-flash
MODEL_VERIFY=gemini-3.5-flash-lite
MODEL_SUMMARIZE=gemini-3.8-flash

FALLBACK_MODEL_CLASSIFY=openai/gpt-oss-20b
FALLBACK_MODEL_REASON=openai/gpt-oss-120b
# Evaluation judge: deliberately a different provider from the system under test.
JUDGE_MODEL=openai/gpt-oss-120b

# Do NOT use: gemini-2.0-flash (shut down), llama-3.3-70b-versatile and
# llama-3.1-8b-instant (Groq deprecated 2026-08-16), llama-4-maverick (deprecated).
# Groq free tier, per organization not per key: 30 RPM / 1000 RPD / 200k TPD.

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ---------- embeddings (local, no key) ----------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Swap to BAAI/bge-m3 (dim 1024) only if Hinglish retrieval measurably suffers.
# That change requires a column migration and a full re-embed.

# ---------- retrieval ----------
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_SPARSE=20
RETRIEVAL_FINAL_K=5
RETRIEVAL_SCORE_MIN=0.35
RERANKER_ENABLED=false

# ---------- agent policy ----------
INTENT_CONFIDENCE_MIN=0.60
MAX_AI_TURNS=4
MAX_TOOL_CALLS=5
AUTO_REFUND_CEILING=1000
AUTO_CANCEL_MAX_AGE_HOURS=24
CONVERSATION_IDLE_HOURS=24

# ---------- whatsapp (twilio sandbox) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# ---------- email (dedicated gmail + app password) ----------
EMAIL_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SUPPORT_EMAIL=
SUPPORT_EMAIL_APP_PASSWORD=
EMAIL_POLL_SECONDS=45

# ---------- voice (stage 10) ----------
VOICE_ENABLED=false
STT_PRIMARY=nvidia/parakeet-tdt-0.6b-v3
STT_FALLBACK=distil-large-v3            # faster-whisper, for other languages
STT_API_FALLBACK=whisper-large-v3       # groq
TTS_VOICE=en_US-amy-medium

# ---------- demo ----------
DEMO_MODE=live          # live | replay
